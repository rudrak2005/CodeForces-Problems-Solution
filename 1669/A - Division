#include <iostream>
 
using namespace std;
 
void solve() {
    int rating;
    cin >> rating;
    if (rating >= 1900) {
        cout << "Division 1
";
    } else if (rating >= 1600) {
        cout << "Division 2
";
    } else if (rating >= 1400) {
        cout << "Division 3
";
    } else {
        cout << "Division 4
";
    }
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}