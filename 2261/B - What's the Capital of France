#include <bits/stdc++.h>
using namespace std;
 
long long solve(vector<int>& a) {
    int o = 0, x = 0;
 
    for (int i = 0; i < a.size(); i++) {
        o |= a[i];
        if (i) x = max(x, a[i] ^ a[i - 1]);
    }
 
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
 
    return o | (x >> 1);
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int &x : a) cin >> x;
 
        cout << solve(a) << '
';
    }
}