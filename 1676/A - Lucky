#include <bits/stdc++.h>
using namespace std;
 
 
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
  int t;
  cin>>t;
  while(t--){
    string s;
    cin>>s;
 
    int fSum=0;
    int sSum=0;
    for(int i =0; i<3; i++){
        fSum += s[i]-'0';
        sSum += s[i+3]-'0';
 
    }
    if(fSum == sSum){
        cout<<"YES
";
    }
    else{
        cout<<"NO
";
 
    }
  }
  return 0;
}